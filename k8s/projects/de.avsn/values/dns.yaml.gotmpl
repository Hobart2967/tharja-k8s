dnsRecords:
- zone: de-avsn
  records:

  - name: "@"
    type: A

  - name: mail
    type: A

  - name: mail
    type: MX
    priority: "10"
    mailServer: "mail.marcoklein.engineer."

  - name: www
    type: A

  - name: autodiscover
    type: CNAME
    target: marcoklein.engineer

  - name: autoconfig
    type: CNAME
    target: marcoklein.engineer

- zone: net-adventurespiele
  records:
  - name: "@"
    type: A

  - name: mail
    type: A

  - name: mail
    type: MX
    priority: "10"
    mailServer: "mail.adventurespiele.net."

  - name: www
    type: A
