---
repositories:
  - name: crowdsecurity
    url: https://crowdsecurity.github.io/helm-charts

releases:
  - name: sys-crowdsec
    namespace: sys-crowdsec
    createNamespace: true
    chart: ../../helm/project

  - name: crowdsec
    namespace: sys-crowdsec
    createNamespace: true
    needs:
      - sys-crowdsec
    chart: crowdsecurity/crowdsec
    version: 0.19.1
    values:
      - ./values/crowdsec.yaml

  - name: crowdsec-bouncer
    namespace: sys-crowdsec
    createNamespace: true
    needs:
      - crowdsec
    chart: ../../helm/crowdsec-bouncer
    values:
      - lapiHost: crowdsec-service.sys-crowdsec.svc.cluster.local
        lapiPort: "8080"
        lapiScheme: http
        mode: stream
        updateMaxFailure: -1
        streamStartupBlock: false
        clientTrustedIPs:
          - 10.42.0.1/32
