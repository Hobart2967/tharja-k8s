---
helmDefaults:
  wait: true
  timeout: 600

repositories:
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts

helmfiles:
  - ./helmfile.common.yaml.gotmpl
  - ./helmfile.kube-prometheus.yaml.gotmpl
  - ./helmfile.grafana.yaml.gotmpl