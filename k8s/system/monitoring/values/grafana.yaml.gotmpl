contactPoints:
  - name: ntfy-server-alerts
    title: Ntfy - Server Alerts
    receiver:
      type: webhook
      disableResolveMessage: true
      settings:
        subject: Grafana Alert
        url: http://ntfy-ntfy.sys-ntfy.svc.cluster.local:80/server_alerts
        httpMethod: POST
        authorization_scheme: Bearer
      valuesFrom:
        - targetPath: authorization_credentials
          valueFrom:
            secretKeyRef:
              name: ntfy-grafana
              key: access_token
dataSources:
  - name: loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    isDefault: false
    editable: false
  - name: prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus-grafana-kube-pr-prometheus.monitoring.svc.cluster.local:9090
    isDefault: true
    editable: false

grafana:
  enabled: false
  adminSecretRef:
    username:
      name: grafana-admin
      key: username
    password:
      name: grafana-admin
      key: password
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi
  persistence:
    enabled: true
    type: pvc
    storageClassName: local-path
    size: 2Gi

  dashboards:
    default:
      crowdsec-overview:
        json: |

      crowdsec-active-blocks:
        json: |
