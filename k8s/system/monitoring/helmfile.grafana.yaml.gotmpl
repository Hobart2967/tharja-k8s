---
helmDefaults:
  wait: true
  timeout: 600

repositories:
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts

releases:

  - name: grafana-operator
    namespace: monitoring
    chart: grafana/grafana-operator
    values:
      - resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 200m
            memory: 256Mi

  - name: grafana-app
    namespace: monitoring
    chart: ../../helm/grafana
    needs:
      - monitoring/grafana-operator
    values:
      - ./values/grafana.yaml.gotmpl

  - name: grafana
    chart: ../../helm/website
    namespace: monitoring
    createNamespace: true
    values:
      - ./values/webfacade.yaml

  - name: host-monitoring
    chart: ../../helm/host-monitoring
    namespace: monitoring
    createNamespace: true